# Server Configuration
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local mongod)
# Example local: mongodb://localhost:27017/interview_ai
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/interview_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/interview_ai

# JWT Secret for candidate session authentication
JWT_SECRET=your_long_random_jwt_secret_key_change_in_production

# Google Gemini API Key for AI interview questions & evaluation
# In AI Studio, this is injected automatically into process.env.GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
